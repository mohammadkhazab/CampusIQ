# Copy to .env and fill in real values. .env is gitignored.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (used by docker-compose to create the DB, and by Django to connect)
POSTGRES_DB=campusiq
POSTGRES_USER=campusiq
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://campusiq:change-me@localhost:5432/campusiq

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
